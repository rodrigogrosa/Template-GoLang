# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s

# Database Configuration
DB_TYPE=in-memory
DB_DSN=

# Kafka Configuration
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=item-events
KAFKA_GROUP_ID=item-service

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Telemetry Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=true
TRACING_URL=localhost:4318
SERVICE_NAME=golang-microservice

# Authentication Configuration
AUTH_ENABLED=false
JWT_SECRET=your-secret-key-here
JWT_ISSUER=golang-microservice

# TLS Configuration
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
