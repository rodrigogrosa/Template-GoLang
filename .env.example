# Server Configuration
PORT=8080
HOST=0.0.0.0
READ_TIMEOUT=10
WRITE_TIMEOUT=10
SHUTDOWN_TIMEOUT=30
ENVIRONMENT=development

# TLS Configuration
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# Logging
LOG_LEVEL=info

# Tracing
TRACING_ENABLED=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces
SERVICE_NAME=template-service

# Kafka Configuration
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=items
KAFKA_GROUP_ID=template-service

# Security
JWT_SECRET=
